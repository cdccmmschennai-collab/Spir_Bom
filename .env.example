# Settings for the Hostinger VPS. Copy to .env and fill in:   cp .env.example .env

# Load the HTTPS port (443) on top of the base setup. Keep this line as-is.
COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# The address users open. Caddy gets a free HTTPS certificate for it.
#   No domain yet: your VPS IP with dashes + .sslip.io
#     e.g. VPS IP 72.60.1.23  ->  SITE_ADDRESS=72-60-1-23.sslip.io
#   With a domain later (after pointing its DNS A record at the VPS IP):
#     SITE_ADDRESS=bom.yourcompany.com
SITE_ADDRESS=

# Login cookie is sent over HTTPS only. Leave true on the server.
COOKIE_SECURE=true
